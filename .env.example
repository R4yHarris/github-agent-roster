# Public metadata examples only. Never commit credentials, .env files, or a PEM.

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
ROSTER_API_KEY=
ROSTER_HOME=

# Optional LLM credential. A non-empty value overrides the same vault name.
# Local endpoints can use llm.api_key_optional: true without a credential.
OPENAI_API_KEY=

# Optional fallback. The vendor/github-agent-contracts submodule takes precedence.
# If set, this must be a non-empty path; relative paths use the caller's cwd.
GITHUB_AGENT_CONTRACTS=../github-agent-contracts

# A. GHCP-authored publication with no completed Roster seat.
# The actual Copilot model is independent of roster.config.yml's served model.
# --model may override AI_MODEL; this workspace declares Max and 1M capacity.
AI_PROVIDER=github-copilot
AI_MODEL=GPT-6.1-Sol
AI_MODEL_VERSION=-
AI_EFFORT=x
AI_CONTEXT_MAX=1000000
# Used and output are unknown on GHCP. Empty values clear stale counts.
AI_CONTEXT_USED=
AI_CONTEXT_OUT=
# Wrappers generate ghcp-<pid> and derive task from branch or issue.
# For direct SDK use, set these to ghcp-<date-or-pid> and a branch slug/issue ID.
AI_SESSION=
AI_TASK=

# B. Completed Roster seat: the last response's run object overrides block A.
# Roster derives these automatically; do not estimate or hardcode token usage.
# Example ONLY for an actual last response reporting 100 prompt / 40 completion:
# AI_PROVIDER=local                 # vLLM; local journal retains vllm
# AI_MODEL=actual-served-model      # response model, or actual request model
# AI_MODEL_VERSION=-
# AI_EFFORT=m                      # seat configuration
# AI_CONTEXT_USED=100              # usage.prompt_tokens; omit if unreported
# AI_CONTEXT_OUT=40                # usage.completion_tokens; omit if unreported
# AI_CONTEXT_MAX=8192              # fleet/config capacity; omit if unknown
# AI_SESSION=roster-42-coder
# AI_TASK=issue-42
# A cloud OpenAI profile uses AI_PROVIDER=openai and its served/API model ID.

# Publish reviewed changes from the feature repository root with App env set.
# Apply the metadata block first; the subject must include Model/Summary/tests.
# node vendor\github-agent-contracts\scripts\agent-pr.mjs --message "..." --model GPT-6.1-Sol --merge-when-green
