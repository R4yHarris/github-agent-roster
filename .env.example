# Names only. Never commit values or a PEM.

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# Optional LLM credential. A non-empty value overrides the same vault name.
# Local endpoints can use llm.api_key_optional: true without a credential.
OPENAI_API_KEY=

# Optional fallback. The vendor/github-agent-contracts submodule takes precedence.
# If set, this must be a non-empty path; relative paths use the caller's cwd.
GITHUB_AGENT_CONTRACTS=../github-agent-contracts

# Publish from the repository root with App env set:
# node vendor/github-agent-contracts/scripts/agent-pr.mjs --message "..."
